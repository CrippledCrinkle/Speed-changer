--// PAGES + TAB LOGIC
local pages = {}
local tabButtons = {}
local activeTab = nil
local isAnimating = false

local function createPage(name)
	local page = new("CanvasGroup", {
		Name = name,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Visible = false,
		GroupTransparency = 0,
		ZIndex = 6,
	}, content)
	new("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, page)
	pages[name] = page
	return page
end

local function selectTab(name)
	if activeTab == name or isAnimating then return end
	isAnimating = true

	local newPage = pages[name]
	local oldPage = activeTab and pages[activeTab]
	activeTab = name

	-- Animate tab buttons
	for tabName, btn in pairs(tabButtons) do
		local isActive = (tabName == name)
		TweenService:Create(btn, TweenInfo.new(0.2), {
			BackgroundColor3 = isActive and ACCENT or BG_TAB,
		}):Play()
		TweenService:Create(btn, TweenInfo.new(0.2), {
			TextColor3 = isActive and Color3.fromRGB(255, 255, 255) or TEXT_DIM,
		}):Play()
	end

	-- Animate old page out (slide left + fade)
	if oldPage then
		TweenService:Create(oldPage, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			GroupTransparency = 1,
			Position = UDim2.new(-0.06, 0, 0, 0),
		}):Play()
		task.delay(0.15, function()
			oldPage.Visible = false
			oldPage.GroupTransparency = 0
			oldPage.Position = UDim2.new(0, 0, 0, 0)
		end)
	end

	-- Animate new page in (slide from right + fade)
	newPage.Visible = true
	newPage.GroupTransparency = 1
	newPage.Position = UDim2.new(0.06, 0, 0, 0)
	TweenService:Create(newPage, TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		GroupTransparency = 0,
		Position = UDim2.new(0, 0, 0, 0),
	}):Play()

	task.delay(0.26, function()
		isAnimating = false
	end)
end

-- Build tab buttons
for i, tabName in ipairs({"Universal", "Current", "About"}) do
	local btn = new("TextButton", {
		Size = UDim2.new(1/3, -4, 1, 0),
