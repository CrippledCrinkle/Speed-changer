--// HELPERS
local function new(className, props, parent)
	local inst = Instance.new(className)
	for prop, value in pairs(props) do
		inst[prop] = value
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function makeDraggable(frame, handle)
	handle = handle or frame
	local dragging, dragStart, startPos = false, nil, nil

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

--// SLIDER CREATOR
local function createSlider(parent, minVal, maxVal, default, onChange, useGradient)
	local container = new("Frame", {
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
	}, parent)

	local track = new("Frame", {
		Size = UDim2.new(1, 0, 0, 8),
		Position = UDim2.new(0, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Color3.fromRGB(48, 48, 58),
		BorderSizePixel = 0,
	}, container)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, track)

	local fill = new("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Color3.fromRGB(90, 150, 255),
		BorderSizePixel = 0,
	}, track)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)

	if useGradient then
		fill.Visible = false
		local gradient = new("UIGradient", {}, track)
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 60, 60)),
			ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 220, 60)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(60, 255, 90)),
			ColorSequenceKeypoint.new(0.50, Color3.fromRGB(60, 240, 255)),
			ColorSequenceKeypoint.new(0.67, Color3.fromRGB(70, 110, 255)),
			ColorSequenceKeypoint.new(0.83, Color3.fromRGB(220, 70, 255)),
			ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 60, 60)),
		})
	end

	local knob = new("Frame", {
		Size = UDim2.new(0, 14, 0, 14),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		ZIndex = 2,
	}, track)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)

	local dragging = false

	local function setVisual(rel)
		knob.Position = UDim2.new(rel, 0, 0.5, 0)
		fill.Size = UDim2.new(rel, 0, 1, 0)
	end

	local function setFromX(x)
		if track.AbsoluteSize.X <= 0 then return end
		local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		setVisual(rel)
		onChange(minVal + (maxVal - minVal) * rel)
	end

	local function setValue(value)
		local rel = math.clamp((value - minVal) / (maxVal - minVal), 0, 1)
		setVisual(rel)
	end

	container.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
			setFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	setValue(default)
	onChange(default)

	return { Set = setValue }
end

