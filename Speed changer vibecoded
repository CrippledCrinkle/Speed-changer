local function selectTab(name)
	for pageName, page in pairs(pages) do
		page.Visible = (pageName == name)
	end
	for tabName, btn in pairs(tabButtons) do
		local active = (tabName == name)
		btn.BackgroundColor3 = active and Color3.fromRGB(58, 120, 220) or Color3.fromRGB(38, 38, 47)
		btn.TextColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(155, 155, 172)
	end
end

